# ResQLens configuration. Copy to ".env" in this folder (setup.bat does it for you)
# and fill in the blanks. NEVER commit the real .env – it is in .gitignore.

APP_ENV=development
# Long random string. setup.bat generates one; or run:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- Database --------------------------------------------------------------
# mysql  = MySQL Server (recommended)   |   sqlite = single file, zero setup
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=resqlens_db
DB_USER=resqlens_app
# Password of the dedicated application user created by database/create_database.sql
DB_PASSWORD=

# TLS to MySQL: 0 for local MySQL, 1 for hosted MySQL (Aiven, TiDB Cloud, ...).
DB_SSL=0
# Optional CA certificate file (e.g. the ca.pem downloaded from Aiven); empty = system CAs
DB_SSL_CA=

# Only used when DB_ENGINE=sqlite (path relative to backend/)
SQLITE_PATH=resqlens.db

# ---- URLs / CORS -------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

TOKEN_TTL_MINUTES=720
# Create the demo account demo@resqlens.dev / Demo@2026 on first start (set 0 in production)
SEED_DEMO=1

# ---- Tests against MySQL (optional) -------------------------------------------
# set TEST_DB_ENGINE=mysql to run backend tests on a separate, disposable database
TEST_DB_ENGINE=sqlite
TEST_DB_NAME=resqlens_test
